    "@types/node": "^20.17.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
